# Most common customizations: ADMIN_DIDS, INFURA_PROJECT_ID, OPENAI_API_KEY

APP_ID=endorser-ch

# usually generated based on NODE_ENV; see flyway.js
#APP_DB_FILE

# usually generated based on NODE_ENV; see flyway-partner.js
#PARTNER_APP_DB_FILE

PORT=3000

# used by Swagger to generate the endpoints; defaults to localhost
#EXT_DOMAIN=localhost

# used by Swagger to generate the endpoints; defaults to 80
#EXT_PORT=3000

# used by Swagger to generate the endpoints; defaults to non-https first, non-empty value swaps
#SWAGGER_HTTPS_DEFAULT=true

LOG_LEVEL=debug

REQUEST_LIMIT=100kb

INFURA_PROJECT_ID=get-from-infura.io

# version of this app
#ENDORSER_VERSION

# service ID, used in RegisterAction claims
SERVICE_ID=endorser.ch

# Global ID IRI prefix, used in PlanAction & Project claims when detecting and creating external IDs on this server
GLOBAL_ID_IRI_PREFIX=https://endorser.ch

# defaults to 10
#DEFAULT_MAX_REGISTRATIONS_PER_MONTH=10

# defaults to 100
# note that registrations are claims, too
#DEFAULT_MAX_CLAIMS_PER_WEEK=100

# server's nostr private key, for relaying eg. to Trustroots.org
#NOSTR_PRIVATE_KEY_NSEC=

# key for AI features, eg. vector embeddings of user profiles
#OPENAI_API_KEY


# DIDs of other services allowed to ask /api/service/membership about a DID.
# Comma-separated. Empty means no service may ask, which is the safe default.
#MEMBERSHIP_SERVICE_DIDS=did:ethr:0x...,did:ethr:0x...

# How long a calling service may cache a membership answer, in seconds.
# This is the upper bound on how long a revocation takes to take effect.
#MEMBERSHIP_CACHE_SECONDS=60

# Identifies this deployment when a client binds a credential with "aud".
# Any agreed string; a URL or DID is conventional. Unset means "aud" is ignored,
# which lets clients adopt the field before this deployment enforces it.
#SERVICE_AUDIENCE_ID=https://api.endorser.ch

# Set to true only once every client sends "aud". Until then a credential
# without one is accepted.
#SERVICE_AUDIENCE_REQUIRED=false

# How often to summarize credentials arriving without an "aud", in milliseconds.
# Logged at warn level, so LOG_LEVEL must be warn or lower to see it.
#UNAUDIENCED_LOG_INTERVAL_MS=3600000

# Longest life allowed for a subjectToken on /api/service/membership, in seconds.
# It is a grant to ask, so it should lapse quickly.
#MEMBERSHIP_SUBJECT_TOKEN_MAX_SECONDS=300
