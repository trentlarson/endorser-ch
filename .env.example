# Most common customizations: ADMIN_DIDS, INFURA_PROJECT_ID, EMBEDDING_MODEL_DIR

APP_ID=endorser-ch

# usually generated based on NODE_ENV; see flyway.js
#APP_DB_FILE

# usually generated based on NODE_ENV; see flyway-partner.js
#PARTNER_APP_DB_FILE

PORT=3000

# Proxies trusted to report the client address in X-Forwarded-For (Express 'trust proxy'),
# which keys the per-address limits. Behind a reverse proxy, set the proxy's address or subnet
# (comma-separated list; 'loopback' for one on the same host) or the number of proxy hops.
# Unset means the connecting address is the client, which is right when nothing fronts the API
# and wrong behind a proxy (every client then shares the proxy's limit).
# "true" is ignored: it would let any client choose its own address.
#TRUST_PROXY=loopback

# used by Swagger to generate the endpoints; defaults to localhost
#EXT_DOMAIN=localhost

# used by Swagger to generate the endpoints; defaults to 80
#EXT_PORT=3000

# used by Swagger to generate the endpoints; defaults to non-https first, non-empty value swaps
#SWAGGER_HTTPS_DEFAULT=true

LOG_LEVEL=debug

REQUEST_LIMIT=100kb

INFURA_PROJECT_ID=get-from-infura.io

# version of this app
#ENDORSER_VERSION

# service ID, used in RegisterAction claims
SERVICE_ID=endorser.ch

# Global ID IRI prefix, used in PlanAction & Project claims when detecting and creating external IDs on this server
GLOBAL_ID_IRI_PREFIX=https://endorser.ch

# defaults to 10
#DEFAULT_MAX_REGISTRATIONS_PER_MONTH=10

# defaults to 100
# note that registrations are claims, too
#DEFAULT_MAX_CLAIMS_PER_WEEK=100

# server's nostr private key, for relaying eg. to Trustroots.org
#NOSTR_PRIVATE_KEY_NSEC=

# Embedding spec for profile & project matching; see src/api/services/embedding-specs.js
#EMBEDDING_SPEC_ID=match-v1-granite311m-r2-q8-256
# Directory holding embedding model files (fill it with: npm run embedding:fetch-model); defaults to ~/.cache/endorser-embedding-models
#EMBEDDING_MODEL_DIR=
# Set to false in production so models load only from EMBEDDING_MODEL_DIR (files are hash-checked either way)
#EMBEDDING_ALLOW_REMOTE_MODELS=true
# Minutes between sweeps that embed new or changed profiles & plans (and retry failures); 0 disables, including the one at startup
#EMBEDDING_SWEEP_INTERVAL_MINUTES=60
# Free-text /api/partner/similar queries allowed per registered DID per minute
#EMBEDDING_QUERY_MAX_PER_MINUTE=20
# ... per unregistered (or revoked) DID per minute
#EMBEDDING_QUERY_MAX_PER_MINUTE_UNREGISTERED=5
# ... per client address per minute: an IPv4 address or an IPv6 /64. Carriers put many phones
# behind one IPv4 address, so this is a burst ceiling. Checked before the per-DID limits.
#EMBEDDING_QUERY_MAX_PER_MINUTE_PER_IP=60
# Free-text queries that may wait for inference (behind profile saves and the sweep); more get a 503.
# 0 turns away every query that isn't in the cache.
#EMBEDDING_QUERY_MAX_QUEUED=10
# Recent query vectors kept in memory, so repeated text costs no inference; 0 disables
#EMBEDDING_QUERY_CACHE_SIZE=1000
# Where clients download the model files (GET /api/partner/embeddingSpecs); defaults to huggingface.co at the pinned revision
#EMBEDDING_ARTIFACT_BASE_URL=


# DIDs of other services allowed to ask /api/service/membership about a DID.
# Comma-separated. Empty means no service may ask, which is the safe default.
#MEMBERSHIP_SERVICE_DIDS=did:ethr:0x...,did:ethr:0x...

# How long a calling service may cache a membership answer, in seconds.
# This is the upper bound on how long a revocation takes to take effect.
#MEMBERSHIP_CACHE_SECONDS=60

# Identifies this deployment when a client binds a credential with "aud".
# Any agreed string; a URL or DID is conventional. Unset means "aud" is ignored,
# which lets clients adopt the field before this deployment enforces it.
#SERVICE_AUDIENCE_ID=https://api.endorser.ch

# Set to true only once every client sends "aud". Until then a credential
# without one is accepted.
#SERVICE_AUDIENCE_REQUIRED=false

# How often to summarize credentials arriving without an "aud", in milliseconds.
# Logged at warn level, so LOG_LEVEL must be warn or lower to see it.
#UNAUDIENCED_LOG_INTERVAL_MS=3600000

# Longest life allowed for a subjectToken on /api/service/membership, in seconds.
# It is a grant to ask, so it should lapse quickly.
#MEMBERSHIP_SUBJECT_TOKEN_MAX_SECONDS=300
