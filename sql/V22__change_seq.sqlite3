-- see README.md in this directory for explanations, and CHANGE/PLAN-accurate-cursors.md

CREATE TABLE change_counter (seq INTEGER NOT NULL);

ALTER TABLE jwt ADD COLUMN changeSeq INTEGER;
ALTER TABLE plan_claim ADD COLUMN changeSeq INTEGER;
ALTER TABLE embedding ADD COLUMN changeSeq INTEGER;

-- number existing rows, one table after another, each in the order it was written
UPDATE jwt SET changeSeq = s.n
  FROM (SELECT rowid AS rid, ROW_NUMBER() OVER (ORDER BY id) AS n FROM jwt) AS s
  WHERE jwt.rowid = s.rid;
UPDATE plan_claim SET changeSeq = s.n + (SELECT COUNT(*) FROM jwt)
  FROM (SELECT rowid AS rid, ROW_NUMBER() OVER (ORDER BY jwtId) AS n FROM plan_claim) AS s
  WHERE plan_claim.rowid = s.rid;
UPDATE embedding SET changeSeq = s.n + (SELECT COUNT(*) FROM jwt) + (SELECT COUNT(*) FROM plan_claim)
  FROM (SELECT rowid AS rid, ROW_NUMBER() OVER (ORDER BY updatedAt, subjectId) AS n FROM embedding) AS s
  WHERE embedding.rowid = s.rid;
INSERT INTO change_counter (seq)
  VALUES ((SELECT COUNT(*) FROM jwt) + (SELECT COUNT(*) FROM plan_claim) + (SELECT COUNT(*) FROM embedding));

CREATE INDEX jwt_changeSeq ON jwt(changeSeq);
CREATE INDEX plan_claim_changeSeq ON plan_claim(changeSeq);
CREATE INDEX embedding_spec_type_changeSeq ON embedding(embeddingSpecId, subjectType, changeSeq);

CREATE TRIGGER jwt_change_seq_insert AFTER INSERT ON jwt
BEGIN
  UPDATE change_counter SET seq = seq + 1;
  UPDATE jwt SET changeSeq = (SELECT seq FROM change_counter) WHERE rowid = NEW.rowid;
END;

-- an edit to a plan replaces its jwtId
CREATE TRIGGER plan_claim_change_seq_insert AFTER INSERT ON plan_claim
BEGIN
  UPDATE change_counter SET seq = seq + 1;
  UPDATE plan_claim SET changeSeq = (SELECT seq FROM change_counter) WHERE rowid = NEW.rowid;
END;
CREATE TRIGGER plan_claim_change_seq_update AFTER UPDATE OF jwtId ON plan_claim
  WHEN OLD.jwtId IS NOT NEW.jwtId
BEGIN
  UPDATE change_counter SET seq = seq + 1;
  UPDATE plan_claim SET changeSeq = (SELECT seq FROM change_counter) WHERE rowid = NEW.rowid;
END;

-- an unchanged text stored again is not a change
CREATE TRIGGER embedding_change_seq_insert AFTER INSERT ON embedding
BEGIN
  UPDATE change_counter SET seq = seq + 1;
  UPDATE embedding SET changeSeq = (SELECT seq FROM change_counter) WHERE rowid = NEW.rowid;
END;
CREATE TRIGGER embedding_change_seq_update AFTER UPDATE OF contentHash ON embedding
  WHEN OLD.contentHash IS NOT NEW.contentHash
BEGIN
  UPDATE change_counter SET seq = seq + 1;
  UPDATE embedding SET changeSeq = (SELECT seq FROM change_counter) WHERE rowid = NEW.rowid;
END;
